{
  "name": "dsh-task-cards",
  "version": "0.1.0",
  "description": "DSH 任务卡：回合结束后由无工具的观察者会话把值得留下的事记成卡（要我决策 / 要我知晓 / 自动处理），面板内直接审批与执行",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./assets/panel.js",
    "./observer-prompt": "./lib/observer-prompt.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "task-cards",
    "任务卡"
  ],
  "license": "MIT",
  "author": "xirizhi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guicaiyue/dsh-task-cards.git"
  },
  "homepage": "https://github.com/guicaiyue/dsh-task-cards#readme",
  "bugs": {
    "url": "https://github.com/guicaiyue/dsh-task-cards/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:abi": "node scripts/check-client-bundle.mjs",
    "budget": "node scripts/check-budgets.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:abi && pnpm budget",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "prepare": "pnpm build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "happy-dom": "^21.0.4",
    "lefthook": "2.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.23.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
