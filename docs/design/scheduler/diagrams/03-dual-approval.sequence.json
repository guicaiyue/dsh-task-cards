  "cards": [
    {
      "dot": "cyan",
      "title": "谁必须经过谁",
      "items": [
        "观察者只建卡与供证据：不验收、不写 outcome、不调执行系统",
        "秘书只出批红 → ApprovedPlan：它没有工具，不直接调执行系统",
        "执行系统只回 ExecutionResult：不决策、不改决定账",
        "调度者是唯一搬运转发的 system：路由 / 队列 / 租约 / 回执"
      ]
    },
    {
      "dot": "emerald",
      "title": "routine 与 major 的分流",
      "items": [
        "routine（c1）：调度者把 CaseFile 交给秘书，秘书 delegated 批红即 ApprovedPlan",
        "通知（c2）：直接给用户看，不进执行队列",
        "major（c3，destructive）：调度者 escalate 给用户，由用户批红或拒绝"
      ]
    },
    {
      "dot": "rose",
      "title": "验收与非抢占",
      "items": [
        "验收分级：system（机器项）、decision（语义项，看证据）、user（重大 / 低置信）",
        "p3 不抢占 p1：同一会话 WIP=1，urgent 只排下一轮队首",
        "failed / outcome-unknown 不自动重投，先补偿或升级"
      ]
    }
  ]
