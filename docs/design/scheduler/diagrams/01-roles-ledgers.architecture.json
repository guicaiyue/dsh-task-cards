  "cards": [
    {
      "dot": "cyan",
      "title": "四层闭环",
      "items": [
        "感知：观察者建卡 + 草拟 acceptance（它不验收）",
        "决策：决策者/秘书默认终审写批红 → ApprovedPlan；重大 / 通知 / 低置信升级用户",
        "执行：执行系统按 ApprovedPlan 排队、领租约、过 adapter，只回 ExecutionResult",
        "验收：验证器分级判定 → Outcome，写回执行账"
      ]
    },
    {
      "dot": "violet",
      "title": "三本账分工",
      "items": [
        "决定账：verdict + authority（delegated / user），approved 时冻结 acceptance",
        "投递账：plan / lease / attempt，派单前先落租约",
        "执行账：result / outcome / evidence，回执与证据同源"
      ]
    },
    {
      "dot": "rose",
      "title": "五条禁令",
      "items": [
        "观察者不验收、不执行；决策者不执行、不碰执行账",
        "执行系统不决策；调度者不写票、不执行",
        "用户不是默认审批人，只接重大 / 通知 / 例外",
        "同一会话 WIP=1 且非抢占：urgent 只排下一轮队首"
      ]
    },
    {
      "dot": "amber",
      "title": "验收分级",
      "items": [
        "system：机器项（构建、测试、契约）",
        "decision：语义项，基于证据判（观察者只给证据）",
        "user：重大 / 低置信才介入",
        "failed / outcome-unknown 不自动重投，先补偿或升级"
      ]
    }
  ]
}