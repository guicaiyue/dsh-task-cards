  "cards": [
    {
      "dot": "cyan",
      "title": "四层怎么读",
      "items": [
        "行是四个阶段：① 感知（建卡 + acceptance 草稿）→ ② 决策（秘书默认终审，重大 / 通知 / 低置信升级用户）",
        "→ ③ 执行（队列 · 租约 · adapter）→ ④ 验收与出口（system / decision / user 分级，通知 / 拦截在此分流）",
        "每个状态的 tag 是这一步的行动者：观察者 / 调度者 / 秘书 / 用户 / 执行系统 / 验证器",
        "approved 时冻结 acceptance：后面只能按这份标准验收"
      ]
    },
    {
      "dot": "rose",
      "title": "不可逆与不自动重投",
      "items": [
        "waiting → dispatched 之前必须先写 lease（红边）",
        "dispatched 之后只能补偿，不能撤回",
        "failed / outcome-unknown 不自动重投：先补偿或升级用户"
      ]
    },
    {
      "dot": "amber",
      "title": "决策默认与升级",
      "items": [
        "秘书默认终审，写批红（authority=delegated）",
        "重大 / 通知 / 低置信才升级用户（authority=user）",
        "通知卡走 notice：用户只看，不进执行队列"
      ]
    },
    {
      "dot": "violet",
      "title": "验收分级",
      "items": [
        "system 判机器项，decision 判语义项（看证据），user 接重大 / 低置信",
        "观察者只提供证据，不能写 outcome",
        "冲突 / 旧票失效走拦截出口，不进入执行"
      ]
    }
  ]
}