{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": ["src/**", "tests/**", "scripts/**", "*.ts", "*.json", "!lib", "!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off"
      },
      "complexity": {
        "useOptionalChain": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/client/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "客户端代码不能碰文件系统",
                  "node:path": "客户端代码不能碰路径",
                  "node:os": "客户端代码不能碰 OS",
                  "../host": "客户端不能直接 import 宿主模块"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/host/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "宿主代码不能 import react",
                  "react-dom": "宿主代码不能 import react-dom"
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
