{
  "name": "dsh-task-cards",
  "version": "0.0.1",
  "description": "DSH 任务卡：回合结束后由无工具的观察者会话把值得留下的事记成卡（要我决策 / 要我知晓 / 自动处理），面板内直接审批与执行",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guicaiyue/dsh-task-cards.git"
  },
  "homepage": "https://github.com/guicaiyue/dsh-task-cards#readme",
  "bugs": {
    "url": "https://github.com/guicaiyue/dsh-task-cards/issues"
  },
  "author": "xirizhi",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./assets/panel.js",
    "./observer-prompt": "./lib/observer-prompt.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "task-cards",
    "任务卡"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/store.mjs && node --check assets/panel.js",
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
